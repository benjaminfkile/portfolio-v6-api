# ---- Local development (TECH_SPEC_V1.md §10) --------------------------------
# When IS_LOCAL=true, ALL config comes from these env vars and NO AWS call is
# made. Leave IS_LOCAL unset in deployed containers to use Secrets Manager.
IS_LOCAL=true
NODE_ENV=development
PORT=3002

# Postgres (local). In this repo's tests a throwaway cluster runs on a unix
# socket: DB_HOST=/tmp DB_PORT=55432 DB_USER=node DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_USER=node
DB_PASSWORD=
DB_NAME=portfolio_v6_local
DB_SSL=false

# Media / CDN
S3_BUCKET_NAME=bk-portfolio-v6-local
CDN_DOMAIN=media-dev.benkile.com

# Cognito (dev pool)
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# Spotify (§4.6). The refresh token is optional when the admin reconnect flow
# has stored one (service_tokens table); it remains as the static fallback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Redirect URI for the admin reconnect flow — must exactly match a Redirect URI
# registered on the Spotify app. Defaults to the loopback callback
# http://127.0.0.1:<PORT>/api/admin/spotify/callback when unset.
#SPOTIFY_REDIRECT_URI=

# Integrations (§4.7). Dedicated key for encrypting stored integration
# credentials at rest (service_tokens). Optional: when unset the store derives
# its key from SPOTIFY_CLIENT_SECRET for back-compat, so existing Spotify
# ciphertext stays decryptable until this key is introduced. Introducing or
# rotating it re-derives the key; prior ciphertext then reads as "not connected"
# and the fix is re-entering the value / reconnecting.
#TOKEN_ENCRYPTION_KEY=

# Gateway health proxy target for /api/status (§3.5 / task 442)
GATEWAY_HEALTH_URL=http://localhost:3000/api/health

# Ops / CloudWatch metrics proxy for /api/ops (§3.5 / v1.3). Name of the
# CloudWatch dashboard the ops live section reads. This is an infra identifier —
# leave it commented/unset locally (there is no AWS in local dev, so /api/ops
# just serves { available: false }); deployed containers set it in the stored
# secret, never in the repo.
#CLOUDWATCH_DASHBOARD_NAME=

# API Keys (v1.16). The narrow machine surface (posts CRUD/publish, the
# post-image media routes, and GET /api/admin/blogs) additionally accepts a
# dashboard-minted API key (`pv6k_...`) presented as a bearer token — no Cognito
# or AWS dependency for the consuming app. Keys are minted, listed, and revoked
# from the admin dashboard (POST/GET/POST /api/admin/api-keys[/:id/revoke]); only
# a SHA-256 hash is ever stored, so there is nothing to configure here.

# ---- Deployed containers (IS_LOCAL unset) -----------------------------------
# AWS_SECRET_ARN=arn:aws:secretsmanager:...:portfolio-v6-api-secrets
# AWS_DB_SECRET_ARN=arn:aws:secretsmanager:...:portfolio-v6-db-secret
